# Get key at https://openrouter.ai/keys
LLM_API_KEY=
LLM_MODEL=
# LLM_MODEL=anthropic/claude-3.5-sonnet

# Optional OpenRouter metadata (helps with rate limits)
SITE_URL=http://localhost
SITE_NAME=SRE-Agent

# --- Memory ---
TURSO_URL=file:./memory/sre.db
# TURSO_AUTH_TOKEN=xxx   # only for remote Turso

# --- MCP (optional) ---
# MCP_COMMAND=npx
# MCP_ARGS=-y @modelcontextprotocol/server-filesystem /tmp

# --- Safety ---
# AUTO_APPROVE=read,mutate   # 'all' to disable gates entirely